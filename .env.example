# Supabase Configuration
# Client-side publishable key is safe to embed in the frontend; RLS remains mandatory.
VITE_SUPABASE_URL=https://cgulvtbyqkixpxxqzcet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY

# Legacy compatibility only; do not add new code using this name.
VITE_SUPABASE_ANON_KEY=

# Server-only secrets (NEVER expose these to the browser or commit real values)
SUPABASE_SECRET_KEYS=
MIDTRANS_SERVER_KEY=your_server_key_here
MIDTRANS_CLIENT_KEY=your_client_key_here
# sandbox (default) or production
MIDTRANS_ENV=sandbox

# Cloudflare AI (optional, for admin voice transcription)
CLOUDFLARE_AI_ENABLED=true

# OTP.ID Configuration
OTPID_BASE_URL=https://api.otp.id
OTPID_API_KEY=your_api_key_here

# Admin webhook security
SEND_SMS_HOOK_SECRET=whsec_your_webhook_secret_here

# Completed jobs expose the Midtrans payment action to employers; settlement is confirmed by webhook.
# WEBHOOK_URL=https://your-domain.pages.dev/api/midtrans/webhook (configured in Midtrans dashboard)
