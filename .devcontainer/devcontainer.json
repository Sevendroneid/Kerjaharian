{
  "name": "KerjaHarian Codex + OpenDesign",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "remoteUser": "node",
  "containerEnv": {
    "COREPACK_ENABLE_PROJECT_SPEC": "1"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "corepack enable && corepack pnpm install --frozen-lockfile && npm install -g @openai/codex && (command -v od >/dev/null 2>&1 || true)",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "KerjaHarian Vite",
      "onAutoForward": "notify"
    }
  }
}
